# =============================================================================
# Project Aurora — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# ------------------------------------------------------------------------------
# Anthropic — Claude Sonnet 4 powers all five AI cornerstones.
# Get a key: https://console.anthropic.com
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default model. RPD §5.7 specifies claude-sonnet-4-20250514.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ------------------------------------------------------------------------------
# Supabase — Postgres, auth, storage, realtime.
# Create a project: https://supabase.com
# URL and anon key are public (prefixed NEXT_PUBLIC_).
# Service role key is server-only. NEVER expose to the client.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by Drizzle for migrations.
DATABASE_URL=

# ------------------------------------------------------------------------------
# WalletConnect — required for RainbowKit / wagmi.
# Get a project ID: https://cloud.walletconnect.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WC_PROJECT_ID=

# ------------------------------------------------------------------------------
# Alchemy — Polygon RPC for reads (NFT ownership, balances, staking position).
# Get a key: https://alchemy.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ALCHEMY_KEY=

# ------------------------------------------------------------------------------
# CoinGecko — token price + market data (primary).
# Get a key: https://www.coingecko.com/en/api
# ------------------------------------------------------------------------------
COINGECKO_API_KEY=

# ------------------------------------------------------------------------------
# CoinMarketCap — token price + market data (fallback).
# Get a key: https://coinmarketcap.com/api
# ------------------------------------------------------------------------------
CMC_API_KEY=

# ------------------------------------------------------------------------------
# Resend — transactional email (welcome, notifications, magic links).
# Get a key: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# Sentry — error tracking.
# Get a DSN: https://sentry.io
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Upstash Redis — rate limiting for AI endpoints, tips, follows, comments.
# Get URL + token: https://upstash.com
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# PostHog — product analytics.
# Get a key: https://posthog.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# Contract addresses (RPD Section 13 — owner inputs pending)
# $NSFW token is live and public; staking and NFT contracts are PENDING.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_NSFW_TOKEN_ADDRESS=0x8f006d1e1d9dc6c98996f50a4c810f17a47fbf19
# PENDING_CONTRACT_ADDRESS — provided by Tim & Paul when ready.
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
# Comma-separated list of NFT collection contract addresses. PENDING.
NEXT_PUBLIC_NFT_CONTRACT_ADDRESSES=

# ------------------------------------------------------------------------------
# Platform configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform fee on tips, subscriptions, and NFT sales. Default 5% (placeholder).
PLATFORM_FEE_BPS=500
# Treasury wallet that receives platform fees. PENDING.
PLATFORM_TREASURY_WALLET=
