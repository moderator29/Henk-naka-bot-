# =============================================================================
# Project Aurora — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# Names match the code exactly.
# =============================================================================

# AI (Anthropic): added when AI phase is funded
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-sonnet-4 in code.
ANTHROPIC_MODEL=

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# WEB3 / WALLET
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ALCHEMY_API_KEY=
ALCHEMY_POLYGON_RPC_URL=

# TOKEN / MARKET DATA
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
# Optional: CoinMarketCap numeric id for $NSFW (enables the CMC fallback).
CMC_NSFW_ID=
# Holder count (Trade terminal + landing). GoldRush/Covalent, free tier.
GOLDRUSH_API_KEY=

# TRADE / SWAP (Trade $NSFW terminal)
# 0x Swap API key (dashboard.0x.org). Server-only.
ZEROX_API_KEY=
# Your Polygon wallet that receives swap fees.
NEXT_PUBLIC_TREASURY_WALLET=
# Swap fee in basis points sent to the treasury (default 100 = 1%).
NEXT_PUBLIC_SWAP_FEE_BPS=100

# EMAIL (Resend): app notifications only, test sender for now
RESEND_API_KEY=
RESEND_FROM_NAME=Pleasure Coin
RESEND_FROM_EMAIL=onboarding@resend.dev

# RATE LIMITING (Upstash Redis): use the REST values
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MONITORING (Sentry): same DSN in both
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for build-time source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ANALYTICS (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# BOT PROTECTION (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CONTRACTS (Polygon)
NEXT_PUBLIC_NSFW_TOKEN_ADDRESS=0x8f006d1e1d9dc6c98996f50a4c810f17a47fbf19
NEXT_PUBLIC_CHAIN_ID=137
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESSES=

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=5

# CRON (Vercel cron auth for renewal reminders, /api/cron/renewals)
CRON_SECRET=

# Set to 1 to hide demo/sample content entirely.
NEXT_PUBLIC_DISABLE_DEMO=
