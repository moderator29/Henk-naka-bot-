{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "DATABASE_URL",
    "NEXT_PUBLIC_WC_PROJECT_ID",
    "NEXT_PUBLIC_ALCHEMY_KEY",
    "NEXT_PUBLIC_NSFW_TOKEN_ADDRESS",
    "NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS",
    "NEXT_PUBLIC_NFT_CONTRACT_ADDRESSES",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "COINGECKO_API_KEY",
    "CMC_API_KEY",
    "CMC_NSFW_ID",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "PLATFORM_FEE_BPS",
    "PLATFORM_TREASURY_WALLET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
